# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=facto
POSTGRES_PASSWORD=
POSTGRES_DB=facto

# Owner credential for the API (at least 24 characters, random). Used by the dashboard server only.
FACTO_ADMIN_TOKEN=

# Address and port the API listens on from the host. Keep 127.0.0.1 unless you
# bind it to a Tailscale address on purpose.
FACTO_BIND_ADDR=127.0.0.1
FACTO_HOST_PORT=3000

# Dashboard (LT-6). Single owner login. The browser never sees FACTO_ADMIN_TOKEN.
FACTO_DASHBOARD_PASSWORD=
# Signs the session cookie, at least 32 random characters.
FACTO_SESSION_SECRET=
FACTO_DASHBOARD_PORT=3001
# Leave empty: the cookie is Secure except on localhost. Set to false only to reach the
# dashboard over plain http on a private network (for example a Tailscale IP).
FACTO_COOKIE_SECURE=
# Optional push notifications through a self-hosted ntfy server (see docs/runbooks/notifications.md).
# Leave empty to keep notifications off. Use your own server, not a public one.
FACTO_NTFY_URL=
FACTO_NTFY_TOPIC=
FACTO_NTFY_TOKEN=
