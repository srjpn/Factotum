# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=facto
POSTGRES_PASSWORD=
POSTGRES_DB=facto

# Interim owner credential for the API (at least 24 characters, random). Replaced by real login in LT-6.
FACTO_ADMIN_TOKEN=

# Address and port the API listens on from the host. Keep 127.0.0.1 unless you
# bind it to a Tailscale address on purpose.
FACTO_BIND_ADDR=127.0.0.1
FACTO_HOST_PORT=3000

# Optional push notifications through a self-hosted ntfy server (see docs/runbooks/notifications.md).
# Leave empty to keep notifications off. Use your own server, not a public one.
FACTO_NTFY_URL=
FACTO_NTFY_TOPIC=
FACTO_NTFY_TOKEN=
